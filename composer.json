{
    "name": "igzard/code-storage-php",
    "description": "Pierre Code Storage SDK for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Any PSR-18 HTTP client works; Guzzle is auto-discovered when installed.",
        "symfony/http-client": "Alternative PSR-18 client, auto-discovered when installed."
    },
    "autoload": {
        "psr-4": {
            "Igzard\\CodeStorage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Igzard\\CodeStorage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
